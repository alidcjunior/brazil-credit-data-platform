# Conexão usada pela CLI (silver/gold)
DATABASE_URL=postgresql+psycopg://brcredit:brcredit@localhost:5432/brcredit
# Banco exclusivo dos testes de integração (nunca aponte para o banco de dados reais)
TEST_DATABASE_URL=postgresql+psycopg://brcredit:brcredit@localhost:5432/brcredit_test
# Raiz do bronze local
DATA_DIR=./data

# Postgres do docker-compose e conexão do dbt
POSTGRES_HOST=localhost
